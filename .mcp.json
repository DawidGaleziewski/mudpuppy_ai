{
  "mcpServers": {
    "mudpuppy": {
      "type": "stdio",
      "command": "pnpm",
      "args": [
        "--dir",
        "apps/crawler",
        "--filter",
        "@mudpuppy/mcp-server",
        "start"
      ],
      "env": {
        "MUDPUPPY_ENV": "local-dev"
      }
    },
    "mudpuppy-ba": {
      "type": "stdio",
      "command": "pnpm",
      "args": [
        "--dir",
        "apps/crawler",
        "--filter",
        "@mudpuppy/mcp-server",
        "start:ba"
      ],
      "env": {
        "MUDPUPPY_ENV": "local-dev"
      }
    }
  }
}
