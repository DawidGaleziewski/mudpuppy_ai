# Dependencies / build output
node_modules/
dist/
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example

# Generated data artifacts (see data/README.md — migrations/ and schema/ stay tracked)
data/db/*
!data/db/.gitkeep
data/evidence/*
!data/evidence/.gitkeep
data/exports/*
!data/exports/.gitkeep
# Unscrubbed per-call Playwright traces (research §13 of specs/005-crawl-run-observability-trace)
data/traces/*
!data/traces/.gitkeep

# SQLite side files, wherever a DB ends up
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm

# Editor / OS
.DS_Store

# Windows download markers (WSL)
*:Zone.Identifier

# Python (uv apps under apps/)
__pycache__/
.venv/
.ruff_cache/
.pytest_cache/

# Scratch test output
.tmp-*.log

# Local request logs written by claude-trace
.claude-trace/
