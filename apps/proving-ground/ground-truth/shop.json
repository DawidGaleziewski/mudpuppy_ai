      "anchor": {
        "screen": "S03",
        "label": "Dostawa"
      },
      "guest_observable": true,
      "claim_markers": [
        "200,00 zł",
        "200 zł",
        "200 PLN"
      ]
    },
    {
      "id": "R02",
      "statement": "Delivery costs 14,99 zł when the products total is below 200 zł.",
