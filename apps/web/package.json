{
  "name": "@mudpuppy/web",
  "version": "0.0.0",
  "private": true,
  "description": "The MudPuppy console as a React single-page app (R-96): the Salvage Yard design system as React components, documented in Storybook, over the dashboard's JSON API",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:dead": "knip --no-progress",
    "lint:dup": "jscpd --config .jscpd.json",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:css && pnpm lint:dead && pnpm lint:dup && pnpm test",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "ds:sync": "node scripts/sync-design-system.mjs && node scripts/gen-utilities.mjs",
    "ds:utilities": "node scripts/gen-utilities.mjs"
  },
  "dependencies": {
    "@a2ui/react": "0.14.0",
    "@a2ui/web_core": "0.14.0",
    "@ag-ui/core": "1.0.3",
    "@hookform/resolvers": "^5.9.2",
    "@reduxjs/toolkit": "^2.13.0",
    "fast-json-patch": "^3.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-redux": "^9.3.0",
    "react-router": "^7.18.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "^10.0.0",
    "@storybook/react-vite": "^10.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jscpd": "^4.0.5",
    "jsdom": "^27.0.0",
    "knip": "^5.88.1",
    "storybook": "^10.0.0",
    "stylelint": "^16.26.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.1"
  }
}
