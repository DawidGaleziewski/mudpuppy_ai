            "allowed_values": [
              "Europa",
              "Świat"
            ]
          }
        },
        {
          "id": "F05.2",
          "label": "Data wyjazdu",
          "type": "date",
          "constraints": {
            "required": true,
            "min": "2026-01-15"
          }
        },
        {
          "id": "F05.3",
          "label": "Data powrotu",
          "type": "date",
          "constraints": {
            "required": true,
            "min": "2026-01-15"
          }
        },
        {
          "id": "F05.4",
          "label": "Liczba podróżnych",
          "type": "number",
          "constraints": {
            "required": true,
            "min": 1,
            "max": 9
          }
        }
      ]
    },
    {
      "id": "F06",
