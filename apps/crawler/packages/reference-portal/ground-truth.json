  "forms": [
    {
      "id": "F01",
      "screen": "S08",
      "label": "Dane pojazdu",
      "method": "get",
      "fields": [
        {
          "id": "F01.1",
          "label": "Marka",
          "type": "select",
          "constraints": {
            "required": true,
            "allowed_values": [
              "Toyota",
              "Skoda",
              "Volkswagen",
              "Fiat",
              "Inna"
            ]
          }
        },
        {
          "id": "F01.2",
          "label": "Model",
          "type": "text",
          "constraints": {
            "required": true,
            "max_length": 40
          }
        },
        {
          "id": "F01.3",
          "label": "Rok produkcji",
          "type": "number",
          "constraints": {
            "required": true,
            "min": 1990,
            "max": 2026
          }
        },
        {
          "id": "F01.4",
          "label": "Pojemność silnika (cm³)",
          "type": "number",
          "constraints": {
            "required": true,
            "min": 50,
            "max": 8000
          }
        },
        {
          "id": "F01.5",
          "label": "Kod pocztowy",
          "type": "text",
          "constraints": {
            "required": true,
            "pattern": "[0-9]{2}-[0-9]{3}"
          }
        }
      ]
    },
    {
      "id": "F02",
      "screen": "S09",
      "label": "Dane kierowcy",
      "method": "get",
      "fields": [
        {
          "id": "F02.1",
          "label": "Data urodzenia",
          "type": "date",
          "constraints": {
            "required": true,
            "min": "1950-01-16",
            "max": "2008-01-15"
          }
        },
        {
          "id": "F02.2",
          "label": "Rok uzyskania prawa jazdy",
          "type": "number",
          "constraints": {
            "required": true,
            "min": 1968,
            "max": 2026
          }
        },
        {
          "id": "F02.3",
          "label": "Lata bezszkodowej jazdy",
          "type": "number",
          "constraints": {
            "required": true,
            "min": 0,
            "max": 60
          }
        },
        {
          "id": "F02.4",
          "label": "Zgoda na przetwarzanie danych osobowych",
          "type": "checkbox",
          "constraints": {
            "required": true
          }
        },
        {
          "id": "F02.5",
          "label": "Oświadczam, że zapoznałem się z OWU",
          "type": "checkbox",
          "constraints": {
            "required": true
          }
        }
      ]
    },
    {
      "id": "F03",
      "screen": "S10",
      "label": "Opcje",
      "method": "get",
      "fields": [
        {
          "id": "F03.1",
          "label": "Zakres",
          "type": "radio",
          "constraints": {
            "required": true,
            "allowed_values": [
              "Tylko OC",
              "OC + Autocasco (AC)"
            ]
          }
        },
        {
          "id": "F03.2",
          "label": "Assistance",
          "type": "checkbox",
          "constraints": {}
        },
        {
          "id": "F03.3",
          "label": "Kod rabatowy",
          "type": "text",
          "constraints": {
            "pattern": "[A-Z]+[0-9]{2}",
            "max_length": 12
          }
        }
      ]
    },
    {
      "id": "F04",
      "screen": "S13",
      "label": "Formularz kontaktowy",
      "method": "post",
      "fields": [
        {
          "id": "F04.1",
          "label": "Imię",
          "type": "text",
          "constraints": {
            "required": true,
            "max_length": 60
          }
        },
        {
          "id": "F04.2",
          "label": "Temat",
          "type": "select",
          "constraints": {
            "required": true,
            "allowed_values": [
              "Oferta",
              "Szkoda",
              "Moja polisa",
              "Inne"
            ]
          }
        },
        {
          "id": "F04.3",
          "label": "Wiadomość",
          "type": "textarea",
          "constraints": {
            "required": true,
            "max_length": 1000
          }
        },
        {
          "id": "F04.4",
          "label": "Telefon",
          "type": "tel",
          "constraints": {
            "pattern": "\\+?[0-9 ]{9,15}"
          }
        },
        {
          "id": "F04.5",
          "label": "E-mail",
          "type": "email",
          "constraints": {}
        }
      ]
    },
    {
      "id": "F05",
      "screen": "S04",
      "label": "Kalkulator podróży",
      "method": "get",
      "fields": [
        {
          "id": "F05.1",
