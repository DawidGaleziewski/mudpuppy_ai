  "rules": [
    {
      "id": "R01",
      "statement": "The driver must be between 18 and 75 years old on the calculation date.",
      "type": "validation",
      "anchor": {
        "screen": "S09",
        "label": "Data urodzenia"
      },
      "guest_observable": true
    },
    {
      "id": "R02",
      "statement": "The postcode must have the format NN-NNN.",
      "type": "format",
      "anchor": {
        "screen": "S08",
        "label": "Kod pocztowy"
      },
      "guest_observable": true
    },
    {
      "id": "R03",
      "statement": "The vehicle production year must be between 1990 and the current year.",
      "type": "range",
      "anchor": {
        "screen": "S08",
        "label": "Rok produkcji"
      },
      "guest_observable": true
    },
    {
      "id": "R04",
      "statement": "The base premium is 800 PLN for OC, plus 1200 PLN when AC is chosen, multiplied by an age factor (up to 25: 1.5; 26-65: 1.0; 66-75: 1.3) and the engine factor.",
      "type": "computation",
      "anchor": {
        "screen": "S11",
        "label": "Składka bazowa"
      },
      "guest_observable": true
    },
    {
      "id": "R05",
      "statement": "The engine factor is 0.9 up to 1400 cm3, 1.0 for 1401-2000 cm3 and 1.25 above 2000 cm3.",
      "type": "computation",
      "anchor": {
        "screen": "S11",
        "label": "Współczynnik silnika"
      },
      "guest_observable": true
    },
    {
      "id": "R06",
      "statement": "Drivers with at least 5 years without claims get a 10% discount on the premium.",
      "type": "computation",
      "anchor": {
        "screen": "S11",
        "label": "Zniżka za bezszkodową jazdę"
      },
      "guest_observable": true
    },
    {
      "id": "R07",
      "statement": "AC cover can be chosen only for vehicles younger than 15 years.",
      "type": "eligibility",
      "anchor": {
        "screen": "S10",
        "label": "OC + Autocasco (AC)"
      },
      "guest_observable": true
    },
    {
      "id": "R08",
      "statement": "The Next button on the driver step is enabled only after both consents are ticked.",
      "type": "ui_enablement",
      "anchor": {
        "screen": "S09",
        "label": "Zgoda na przetwarzanie danych osobowych"
      },
      "guest_observable": true
    },
    {
      "id": "R09",
      "statement": "Assistance adds 99 PLN to the premium.",
      "type": "computation",
      "anchor": {
        "screen": "S11",
        "label": "Assistance"
      },
      "guest_observable": true
    },
    {
      "id": "R10",
      "statement": "A discount code must be capital letters followed by two digits.",
      "type": "format",
      "anchor": {
        "screen": "S10",
        "label": "Kod rabatowy"
      },
      "guest_observable": true
    },
    {
      "id": "R11",
      "statement": "The active discount code WIOSNA10 takes 10% off the premium after the no-claims discount; other well-formed codes are reported as inactive.",
      "type": "computation",
      "anchor": {
        "screen": "S11",
        "label": "Kod rabatowy"
      },
      "guest_observable": true
    },
    {
      "id": "R12",
      "statement": "Travel insurance covers at most 90 days including the departure and return days.",
      "type": "validation",
      "anchor": {
        "screen": "S04",
        "label": "Data powrotu"
      },
      "guest_observable": true
    },
    {
      "id": "R13",
      "statement": "The travel departure date cannot be earlier than today.",
      "type": "validation",
      "anchor": {
        "screen": "S04",
        "label": "Data wyjazdu"
      },
      "guest_observable": true
    },
    {
      "id": "R14",
      "statement": "The travel premium is days x daily rate (Europe 12 PLN, World 25 PLN) x number of travellers.",
      "type": "computation",
      "anchor": {
        "screen": "S05",
        "label": "Stawka dzienna"
      },
      "guest_observable": true
    },
    {
      "id": "R15",
      "statement": "A contact request needs a phone number or an e-mail address.",
      "type": "validation",
      "anchor": {
        "screen": "S13",
        "label": "Telefon"
      },
      "guest_observable": true
    },
    {
      "id": "R16",
      "statement": "Two different products must be chosen to compare them.",
      "type": "validation",
      "anchor": {
        "screen": "S06",
        "label": "Drugi produkt"
      },
      "guest_observable": true
    },
    {
      "id": "R17",
      "statement": "A policy can be renewed online only within 30 days before it expires.",
      "type": "eligibility",
      "anchor": {
        "screen": "S19",
        "label": "Przedłuż polisę"
      },
      "guest_observable": false
    },
    {
      "id": "R18",
      "statement": "Claim payouts above 50 000 PLN need a second adjuster's approval.",
      "type": "validation",
      "anchor": {
        "screen": "S15",
        "label": "Zgłoszenie szkody"
      },
      "guest_observable": false
    },
    {
      "id": "R19",
      "statement": "An agent commission of 12% is included in the total premium.",
      "type": "computation",
      "anchor": {
        "screen": "S11",
        "label": "Składka łączna"
      },
      "guest_observable": false
    }
  ],
