{
  "name": "pathfinder-ai",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:pii": "tsx scripts/pii-audit.ts",
    "stability": "tsx scripts/stability-check.ts",
    "portal:export": "tsx scripts/portal-export.ts",
    "portal:delete": "tsx scripts/portal-delete.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pathfinder/core": "workspace:*",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
