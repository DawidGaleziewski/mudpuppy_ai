{
  "name": "pathfinder-ai",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fast": "tsx scripts/test-tier.ts fast",
    "test:slow": "tsx scripts/test-tier.ts slow",
    "typecheck": "pnpm --filter \"./packages/*\" exec tsc --noEmit && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:report": "tsx scripts/lint-report.ts",
    "mutate": "tsx scripts/mutate.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:pii": "tsx scripts/pii-audit.ts",
    "stability": "tsx scripts/stability-check.ts",
    "portal:export": "tsx scripts/portal-export.ts",
    "portal:delete": "tsx scripts/portal-delete.ts",
    "trace:import-agent": "tsx scripts/trace-import-agent.ts",
    "docs:audit": "tsx scripts/docs-audit.ts",
    "docs:review": "tsx scripts/docs-review.ts",
    "docs:export": "tsx scripts/docs-export.ts",
    "docs:evaluate": "tsx scripts/docs-evaluate.ts",
    "wireframes:build": "tsx scripts/wireframes-build.ts",
    "trace:smoke": "tsx packages/mcp-server/scripts/trace-smoke.ts",
    "reference-portal": "pnpm --filter @pathfinder/reference-portal start",
    "vault": "tsx scripts/vault.ts",
    "eval": "tsx evals/index.ts",
    "eval:judge": "tsx evals/judge.ts",
    "eval:draw": "tsx evals/draw.ts",
    "eval:calibrate": "tsx evals/calibrate.ts",
    "eval:judge-check": "tsx evals/judge-check.ts",
    "tokens:ba": "tsx scripts/tokens-ba-reads.ts",
    "gt:check": "vitest run --project gates tests/ground-truth.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pathfinder/core": "workspace:*",
    "@pathfinder/docs": "workspace:*",
    "@pathfinder/gates": "workspace:*",
    "@pathfinder/mcp-server": "workspace:*",
    "@pathfinder/store": "workspace:*",
    "@pathfinder/vault": "workspace:*",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
