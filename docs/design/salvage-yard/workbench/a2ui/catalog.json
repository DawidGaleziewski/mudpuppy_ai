{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mudpuppy.local/a2ui/catalogs/workbench/v1/catalog.json",
  "catalogId": "https://mudpuppy.local/a2ui/catalogs/workbench/v1/catalog.json",
  "title": "MudPuppy Workbench catalog v1 (A2UI v0.9.1)",
  "description": "Generated by workbench/tools/gen_wb_schema.py from the same CATALOGUE as view-spec.schema.json. Agent-owned components take ids and options only; the server adds 'data' (a path into the surface's data model) and writes every observed value there with updateDataModel. View and CommandCard are server-owned. 'root' is reserved for View.",
  "components": {
    "LiveMap": {
      "type": "object",
      "description": "Pages the crawler visited, in visit order, with miniatures, edges, its current position and the queue, with the scan meter in its body. Side trips fold into a '+N side pages' chip on the page they came from.",
      "required": [
        "id",
        "component",
        "scan"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/componentId"
        },
        "component": {
          "const": "LiveMap"
        },
        "scan": {
          "$ref": "#/$defs/scanId"
        },
        "follow": {
          "type": "boolean",
          "default": true,
          "description": "Keep the crawler's position in view."
        },
        "view": {
          "enum": [
            "graph",
            "filmstrip"
          ],
          "default": "graph",
          "description": "Inline cards always use filmstrip."
        },
        "highlight": {
          "$ref": "#/$defs/pageRef"
        },
        "data": {
          "$ref": "#/$defs/serverBinding"
        }
      },
      "unevaluatedProperties": false,
      "x-mudpuppy": {
        "owner": "agent",
        "serverProps": [
          "data"
        ],
        "phase": 1,
        "paths": [
          "mapping"
        ],
        "placement": {
          "inline": "card",
          "split": "stage",
          "focus": "stage"
        },
        "dataPath": "/scans/{scan}",
        "data": "events (SSE, data lane)",
        "actions": [
          {
            "name": "page.select",
            "context": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "route"
              ],
              "properties": {
                "route": {
                  "$ref": "#/$defs/route"
                },
                "state": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50
                }
              }
            },
            "does": "select a page (fills PageDetail)"
          },
          {
            "name": "page.ask",
            "context": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "route"
              ],
              "properties": {
                "route": {
                  "$ref": "#/$defs/route"
                },
                "state": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50
                }
              }
            },
            "does": "add the page as context to the next message"
          },
          {
            "name": "map.follow",
            "context": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "on"
              ],
              "properties": {
                "on": {
                  "type": "boolean"
                }
              }
            },
            "does": ""
          },
          {
            "name": "map.open",
            "context": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            },
            "does": "open the full map"
          }
        ]
      }
    },
    "ScanMeter": {
      "type": "object",
      "description": "Steps of the limit, pages, queued links, where the crawler is now. For views without a LiveMap (it has its own meter).",
