          "focus": "stage"
        },
        "dataPath": "/scans/{scan}/pages",
        "data": "screenshots",
        "actions": [
          {
            "name": "page.select",
            "context": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "route"
              ],
              "properties": {
                "route": {
                  "$ref": "#/$defs/route"
                },
                "state": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50
                }
              }
            },
            "does": ""
          },
          {
            "name": "page.ask",
            "context": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "route"
              ],
              "properties": {
                "route": {
