        "data": "events",
        "actions": [
          {
            "name": "scan.stop",
            "context": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            },
            "does": "",
            "write": "the server answers with a CommandCard on the same surface; nothing runs before command.confirm"
          }
        ]
      }
    },
