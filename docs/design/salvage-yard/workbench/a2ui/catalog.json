  "functions": [],
  "theme": {},
  "$defs": {
    "scanId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Full scan id: a canonical lowercase UUID (UUIDv7), e.g. 01a110d5-2028-7000-8f3e-5c1a9b27d460. Never the short form."
    },
    "step": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000,
      "description": "Step number within the scan."
    },
    "eventRef": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}#[0-9]{1,6}$",
      "description": "Full scan id # step, e.g. 01a110d5-2028-7000-8f3e-5c1a9b27d460#171."
    },
    "route": {
      "type": "string",
      "pattern": "^/[^\\s<>\"']{0,200}$",
      "description": "A route as recorded, e.g. /kalkulator/kierowca."
    },
    "pageRef": {
      "description": "A page (screen state) in a scan: the current selection, or a route with an optional same-URL step.",
      "oneOf": [
        {
          "const": "@selected"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "route"
          ],
          "properties": {
            "route": {
              "$ref": "#/$defs/route"
            },
            "state": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Same-URL step (step 2 of /kalkulator/kierowca)."
            }
          }
        }
      ]
    },
    "recordId": {
      "type": "string",
      "pattern": "^(SCR|PROC|BR|CAP|NFR|REQ|UC|DI|GL|ASM|OQ|FUP|API)-[0-9]{3,}$",
      "description": "A documentation record, process or rule, three or more digits: SCR-001, PROC-001, BR-021, BR-1001, REQ-004, UC-012, CAP-005, NFR-001 … Portal pages are pageRefs, not records."
    },
    "changeId": {
      "type": "string",
      "pattern": "^CHG-[0-9]{3,}$"
    },
    "findingId": {
      "type": "string",
      "pattern": "^FND-[0-9]{3,}$"
    },
    "ruleId": {
      "type": "string",
      "pattern": "^BR-[0-9]{3,}$"
    },
    "plainText": {
      "type": "string",
      "pattern": "^[^<>{}]*$",
      "description": "Plain words. No markup, no template syntax."
    },
    "personaName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,23}$",
      "description": "A persona of the portal, lower case: guest, client, premium. The server resolves it (unknown → id_not_found)."
    },
    "vaultRef": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,47}$",
      "description": "A credential's name in the vault, e.g. CLIENT_LOGIN. Never a value: values go to the vault through its own dialog."
    },
    "componentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,23}$"
    },
    "serverBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[^\\s]{0,300}$"
        }
      },
      "description": "Added by the server: where this component's data lives in the surface's data model. Dropped if the agent sends it."
    }
  },
  "x-mudpuppy": {
    "limits_per_path": {
      "chat": 2,
      "mapping": 4,
      "troubleshoot": 4,
      "explain": 3
    },
    "reserved_ids": [
      "root"
    ],
    "dataModel": {
      "/view": "frame facts: path, why, phase, source line, data time (server)",
      "/scans/{scan}": "meter, pages (visit order), edges, narration, stop, steps/{n}, events, fixes/{n}, attempts/{n} (server, from the data lane)",
      "/records/{id}": "portal-model records",
      "/rules/{id}": "decision tables",
      "/changes/{id}": "before / after",
      "/findings/{id}": "findings",
      "/commands/{id}": "command cards: state, facts, args (args two-way for editable cards)",
      "/ui/selected": "the selected page (client state, sent back in action context)"
    }
  }
}
